/* ============================================================
   PicMetadata — modern light theme
   Palette:
     background  #F4F5F9
     surface     #FFFFFF
     border      #E3E5EC
     text        #1A1D29 / #6B7280 / #9CA3AF
     accent      #4F46E5 (indigo)
   ============================================================ */

* {
    outline: none;
    font-family: "Segoe UI", "Segoe UI Variable", Arial, sans-serif;
}

QMainWindow, QDialog {
    background-color: #F4F5F9;
}

QWidget {
    color: #1A1D29;
    font-size: 13px;
}

QLabel {
    background: transparent;
}

/* ---------------------------------------------------------------
   Header bar (folder path + actions)
--------------------------------------------------------------- */
QFrame#headerCard {
    background-color: #FFFFFF;
    border: 1px solid #E3E5EC;
    border-radius: 12px;
}

QLabel#folderIconLabel {
    font-size: 18px;
    color: #4F46E5;
    background: transparent;
}

QLabel#folderCaption {
    color: #9CA3AF;
    font-size: 11px;
    font-weight: 600;
}

QLabel#folderPathName {
    color: #1A1D29;
    font-size: 13px;
    font-weight: 600;
}

/* ---------------------------------------------------------------
   Secondary "pill" buttons — change folder / refresh
--------------------------------------------------------------- */
QToolButton#changeFolderButton,
QToolButton#updateDataButton {
    background-color: #F4F5F9;
    border: 1px solid #E3E5EC;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
    color: #1A1D29;
}
QToolButton#changeFolderButton:hover,
QToolButton#updateDataButton:hover {
    background-color: #EEF2FF;
    border-color: #C7D2FE;
    color: #4338CA;
}
QToolButton#changeFolderButton:pressed,
QToolButton#updateDataButton:pressed {
    background-color: #E0E7FF;
}
QToolButton#changeFolderButton:disabled,
QToolButton#updateDataButton:disabled {
    color: #B4B7C2;
    background-color: #F4F5F9;
    border-color: #E3E5EC;
}

/* ---------------------------------------------------------------
   Stat cards
--------------------------------------------------------------- */
QFrame#statCard {
    background-color: #FFFFFF;
    border: 1px solid #E3E5EC;
    border-radius: 12px;
}
QFrame#statCard[accent="brand"]   { border-left: 4px solid #4F46E5; }
QFrame#statCard[accent="warning"] { border-left: 4px solid #D97706; }
QFrame#statCard[accent="success"] { border-left: 4px solid #16A34A; }
QFrame#statCard[accent="info"]    { border-left: 4px solid #0D9488; }
QFrame#statCard[accent="neutral"] { border-left: 4px solid #9CA3AF; }

QLabel#statValueImages, QLabel#statValueNoData, QLabel#statValueFixedAuto,
QLabel#statValueFixedManual, QLabel#statValueSkipped {
    font-size: 26px;
    font-weight: 700;
    color: #1A1D29;
}
QLabel#statCaptionImages, QLabel#statCaptionNoData, QLabel#statCaptionFixedAuto,
QLabel#statCaptionFixedManual, QLabel#statCaptionSkipped {
    font-size: 11px;
    font-weight: 600;
    color: #6B7280;
}

/* ---------------------------------------------------------------
   Mode tiles — big colorful action buttons
--------------------------------------------------------------- */
QPushButton#autoButton, QPushButton#manualButton,
QPushButton#singleImgButton, QPushButton#hybridModeButton {
    text-align: left;
    padding: 16px 20px;
    border-radius: 12px;
    border: 1px solid #E3E5EC;
    background-color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
    color: #1A1D29;
}

QPushButton#autoButton {
    border-left: 4px solid #4F46E5;
}
QPushButton#autoButton:hover {
    background-color: #EEF2FF;
    border-color: #C7D2FE;
}
QPushButton#autoButton:pressed {
    background-color: #E0E7FF;
}

QPushButton#manualButton {
    border-left: 4px solid #0D9488;
}
QPushButton#manualButton:hover {
    background-color: #EDFCFA;
    border-color: #99F0E4;
}
QPushButton#manualButton:pressed {
    background-color: #CCFBF1;
}

QPushButton#singleImgButton {
    border-left: 4px solid #D97706;
}
QPushButton#singleImgButton:hover {
    background-color: #FFFBEB;
    border-color: #FDE4A8;
}
QPushButton#singleImgButton:pressed {
    background-color: #FEF0C7;
}

QPushButton#hybridModeButton {
    border-left: 4px solid #7C3AED;
}
QPushButton#hybridModeButton:hover {
    background-color: #F5F3FF;
    border-color: #DDD6FE;
}
QPushButton#hybridModeButton:pressed {
    background-color: #EDE9FE;
}

QPushButton#autoButton:disabled, QPushButton#manualButton:disabled,
QPushButton#singleImgButton:disabled, QPushButton#hybridModeButton:disabled {
    color: #B4B7C2;
    background-color: #FAFAFB;
    border-color: #E3E5EC;
}

QLabel#autoCaption, QLabel#manualCaption,
QLabel#singleImgCaption, QLabel#hybridCaption {
    font-size: 12px;
    color: #6B7280;
    font-weight: 500;
}

/* ---------------------------------------------------------------
   Table (kept for compatibility, styled flat/borderless)
--------------------------------------------------------------- */
QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E3E5EC;
    border-radius: 12px;
    gridline-color: #EEF0F5;
    selection-background-color: #EEF2FF;
    selection-color: #1A1D29;
}
QHeaderView::section {
    background-color: #FAFAFB;
    color: #6B7280;
    font-weight: 600;
    border: none;
    border-bottom: 1px solid #E3E5EC;
    padding: 6px 10px;
}
QTableWidget::item {
    padding: 4px 8px;
}

/* ---------------------------------------------------------------
   Status bar
--------------------------------------------------------------- */
QStatusBar {
    background-color: #F4F5F9;
    color: #6B7280;
    border-top: 1px solid #E3E5EC;
}

/* ---------------------------------------------------------------
   Menu bar / menus
--------------------------------------------------------------- */
QMenuBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E3E5EC;
    padding: 2px 4px;
}
QMenuBar::item {
    padding: 6px 12px;
    border-radius: 6px;
    background: transparent;
}
QMenuBar::item:selected {
    background-color: #EEF2FF;
    color: #4338CA;
}
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E3E5EC;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item {
    padding: 7px 20px 7px 12px;
    border-radius: 6px;
    color: #1A1D29;
}
QMenu::item:selected {
    background-color: #EEF2FF;
    color: #4338CA;
}
QMenu::separator {
    height: 1px;
    background: #E3E5EC;
    margin: 4px 8px;
}

/* ---------------------------------------------------------------
   Generic buttons (dialogs, message boxes)
--------------------------------------------------------------- */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #E3E5EC;
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: 600;
    color: #1A1D29;
}
QPushButton:hover {
    background-color: #F4F5F9;
    border-color: #D3D6E0;
}
QPushButton:pressed {
    background-color: #E9EAF0;
}
QPushButton:default {
    background-color: #4F46E5;
    border-color: #4F46E5;
    color: #FFFFFF;
}
QPushButton:default:hover {
    background-color: #4338CA;
    border-color: #4338CA;
}
QPushButton:default:pressed {
    background-color: #3730A3;
    border-color: #3730A3;
}
QPushButton:disabled {
    color: #B4B7C2;
    background-color: #FAFAFB;
    border-color: #E3E5EC;
}

/* Manual-date dialog specific buttons */
QPushButton#confirmButton {
    background-color: #4F46E5;
    border-color: #4F46E5;
    color: #FFFFFF;
}
QPushButton#confirmButton:hover {
    background-color: #4338CA;
    border-color: #4338CA;
}
QPushButton#confirmButton:pressed {
    background-color: #3730A3;
    border-color: #3730A3;
}
QPushButton#abortButton {
    background-color: #FFFFFF;
    border-color: #FCA5A5;
    color: #DC2626;
}
QPushButton#abortButton:hover {
    background-color: #FEF2F2;
    border-color: #F87171;
}
QPushButton#abortButton:pressed {
    background-color: #FEE2E2;
}
QPushButton#skipButton {
    background-color: #FFFFFF;
    border-color: #E3E5EC;
    color: #6B7280;
}
QPushButton#skipButton:hover {
    background-color: #F4F5F9;
    color: #1A1D29;
}

/* ---------------------------------------------------------------
   Manual date dialog — image preview + inputs
--------------------------------------------------------------- */
QLabel#imagePreview {
    background-color: #FAFAFB;
    border: 1px solid #E3E5EC;
    border-radius: 12px;
}
QLabel#fileNameLabel {
    color: #1A1D29;
    font-size: 13px;
    font-weight: 600;
}
QLabel#dateLabel {
    color: #6B7280;
    font-weight: 600;
}

QDateTimeEdit {
    background-color: #FFFFFF;
    border: 1px solid #E3E5EC;
    border-radius: 8px;
    padding: 7px 10px;
    selection-background-color: #4F46E5;
}
QDateTimeEdit:focus {
    border: 1px solid #4F46E5;
}
QDateTimeEdit::drop-down {
    border: none;
    width: 22px;
}
QCalendarWidget QToolButton {
    background-color: transparent;
    border-radius: 6px;
    padding: 4px 8px;
    font-weight: 600;
}
QCalendarWidget QToolButton:hover {
    background-color: #EEF2FF;
}
QCalendarWidget QAbstractItemView:enabled {
    selection-background-color: #4F46E5;
    selection-color: #FFFFFF;
}

/* ---------------------------------------------------------------
   Scrollbars — slim, unobtrusive
--------------------------------------------------------------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #D3D6E0;
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #B4B7C2;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #D3D6E0;
    border-radius: 5px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    background: #B4B7C2;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ---------------------------------------------------------------
   Tooltips
--------------------------------------------------------------- */
QToolTip {
    background-color: #1A1D29;
    color: #FFFFFF;
    border: none;
    padding: 6px 10px;
    border-radius: 6px;
}
